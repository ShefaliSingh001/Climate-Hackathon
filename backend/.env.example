# Copy to backend/.env for local development (never commit .env). On Vercel, set these as environment variables.

# For the AI-written monthly impact report. Without it the dashboard shows a template report.
ANTHROPIC_API_KEY=

# From Supabase: Project Settings -> API. Copy to .env (never commit .env).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row level security; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
